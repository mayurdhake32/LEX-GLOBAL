<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Lex Global Advocacy — International Legal Counsel & Education</title>
<meta name="description" content="Lex Global Advocacy — premium international legal courses, guides, and knowledge for practitioners and global citizens." />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#0A1D37; --navy-2:#0F2647; --navy-3:#16345C;
    --ivory:#F7F3EB; --ivory-2:#FCFAF5;
    --gold:#B08D57; --gold-soft:#D4B483; --gold-pale:#EFE3CF;
    --ink:#17202E; --muted:#5E6A7A;
    --line:rgba(10,29,55,.12); --line-strong:rgba(10,29,55,.22);
    --white:#fff; --radius:20px; --radius-sm:12px;
    --shadow:0 30px 80px rgba(10,29,55,.12);
    --shadow-sm:0 12px 36px rgba(10,29,55,.08);
    --serif:'Fraunces', Georgia, serif;
    --sans:'Inter', system-ui, -apple-system, sans-serif;
    --max:1280px;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth; scroll-padding-top:100px;}
  body{background:var(--ivory); color:var(--ink); font-family:var(--sans); font-size:16px; line-height:1.7; -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility; overflow-x:hidden;}
  body.cmdk-open, body.modal-open{overflow:hidden;}
  img{display:block; max-width:100%;}
  a{color:inherit; text-decoration:none;}
  button,input,select,textarea{font:inherit; color:inherit;}
  button{cursor:pointer; background:none; border:none;}
  :focus-visible{outline:3px solid var(--gold); outline-offset:3px; border-radius:4px;}
  ::selection{background:var(--gold); color:#fff;}
  .wrap{width:min(var(--max), calc(100% - 56px)); margin-inline:auto;}
  h1,h2,h3,h4,.serif{font-family:var(--serif); font-weight:600; letter-spacing:-.02em; line-height:1.06;}
  h1{font-size:clamp(2.9rem, 6.4vw, 5.6rem);}
  h2{font-size:clamp(2rem, 3.8vw, 3.4rem);}
  h3{font-size:clamp(1.3rem, 2vw, 1.75rem);}
  p{color:var(--muted);}
  .lead{font-size:1.1rem; color:#485667; line-height:1.8; max-width:62ch;}
  .eyebrow{font-size:.7rem; font-weight:600; letter-spacing:.22em; text-transform:uppercase; color:var(--gold); display:inline-flex; align-items:center; gap:.7rem;}
  .eyebrow::before{content:""; width:32px; height:1px; background:var(--gold);}
  .eyebrow.center{justify-content:center;}
  .eyebrow.center::after{content:""; width:32px; height:1px; background:var(--gold);}

  .btn{position:relative; display:inline-flex; align-items:center; justify-content:center; gap:.55rem; padding:.92rem 1.6rem; border-radius:999px; border:1px solid transparent; font-size:.82rem; font-weight:600; letter-spacing:.04em; transition:background .3s, color .3s, border-color .3s, box-shadow .3s, transform .3s; white-space:nowrap; will-change:transform;}
  .btn-primary{background:var(--navy); color:var(--ivory); box-shadow:0 12px 30px rgba(10,29,55,.22);}
  .btn-primary:hover{background:var(--navy-3); box-shadow:0 16px 40px rgba(10,29,55,.28);}
  .btn-gold{background:var(--gold); color:#fff; box-shadow:0 12px 30px rgba(176,141,87,.28);}
  .btn-gold:hover{background:#9C7A45; box-shadow:0 16px 40px rgba(176,141,87,.36);}
  .btn-outline{background:transparent; border-color:var(--line-strong); color:var(--navy);}
  .btn-outline:hover{border-color:var(--navy); background:rgba(10,29,55,.04);}
  .btn-ghost{background:transparent; color:var(--navy); padding-inline:.2rem;}
  .btn-ghost:hover{color:var(--gold);}
  .btn-sm{padding:.62rem 1.05rem; font-size:.76rem;}
  .btn-lg{padding:1.05rem 2rem; font-size:.9rem;}
  .btn .arrow{transition:transform .3s;}
  .btn:hover .arrow{transform:translateX(3px);}

  .cursor-glow{position:fixed; width:340px; height:340px; border-radius:50%; background:radial-gradient(circle, rgba(176,141,87,.14), transparent 65%); pointer-events:none; z-index:0; transform:translate(-50%,-50%); transition:opacity .4s; opacity:0; top:0; left:0;}
  @media (pointer:fine){ .cursor-glow.active{opacity:1;} }

  .site-header{position:sticky; top:0; z-index:60; background:rgba(247,243,235,.85); backdrop-filter:blur(20px) saturate(1.4); -webkit-backdrop-filter:blur(20px) saturate(1.4); border-bottom:1px solid var(--line); transition:box-shadow .3s;}
  .site-header.scrolled{box-shadow:0 8px 30px rgba(10,29,55,.06);}
  .header-inner{display:flex; align-items:center; justify-content:space-between; min-height:88px; gap:2rem;}
  .brand{display:flex; align-items:center; gap:.85rem; flex-shrink:0;}
  .brand-mark{width:44px; height:44px; border-radius:50%; border:1.5px solid var(--gold); display:grid; place-items:center; position:relative; font-family:var(--serif); font-size:1.05rem; font-weight:600; color:var(--navy); background:var(--ivory-2); letter-spacing:-.02em;}
  .brand-mark::after{content:""; position:absolute; inset:4px; border-radius:50%; border:1px solid rgba(176,141,87,.35);}
  .brand-name{font-family:var(--serif); font-size:1.3rem; font-weight:600; color:var(--navy); line-height:1.05; letter-spacing:-.02em;}
  .brand-sub{font-size:.58rem; letter-spacing:.24em; text-transform:uppercase; color:var(--gold); margin-top:.32rem;}
  .main-nav{display:flex; align-items:center; gap:1.9rem;}
  .main-nav a{font-size:.82rem; font-weight:500; color:var(--navy); letter-spacing:.02em; position:relative; padding:.4rem 0; transition:color .2s;}
  .main-nav a::after{content:""; position:absolute; left:0; bottom:0; height:1.5px; width:0; background:var(--gold); transition:width .35s cubic-bezier(.16,1,.3,1);}
  .main-nav a:hover{color:var(--gold);}
  .main-nav a:hover::after, .main-nav a.active::after{width:100%;}
  .main-nav a.active{color:var(--gold);}
  .header-actions{display:flex; align-items:center; gap:.7rem;}
  .cmdk-trigger{display:inline-flex; align-items:center; gap:.55rem; padding:.55rem .55rem .55rem .85rem; border:1px solid var(--line-strong); border-radius:999px; font-size:.78rem; color:var(--muted); background:var(--ivory-2); transition:border-color .2s, background .2s, color .2s;}
  .cmdk-trigger:hover{border-color:var(--navy); color:var(--navy);}
  .cmdk-trigger kbd{font-family:var(--sans); font-size:.62rem; font-weight:600; padding:.2rem .4rem; background:var(--white); border:1px solid var(--line); border-radius:5px; color:var(--navy);}
  .menu-toggle{display:none; width:44px; height:44px; border:1px solid var(--line-strong); border-radius:50%; color:var(--navy); place-items:center;}
  .mobile-nav{display:none; border-top:1px solid var(--line); background:var(--ivory); padding:.5rem 0 1.5rem;}
  .mobile-nav.open{display:block; animation:slideDown .3s ease;}
  @keyframes slideDown{from{opacity:0; transform:translateY(-8px);} to{opacity:1; transform:none;}}
  .mobile-nav a{display:block; padding:.9rem 0; border-bottom:1px solid var(--line); font-weight:500; color:var(--navy);}

  .hero{padding:clamp(3.5rem, 8vw, 7rem) 0 clamp(3rem, 6vw, 5.5rem); position:relative;}
  .hero::before{content:""; position:absolute; right:-15%; top:-20%; width:60vw; height:60vw; background:radial-gradient(circle, rgba(176,141,87,.12), transparent 62%); pointer-events:none; z-index:-1;}
  .hero-grid{display:grid; grid-template-columns:1.05fr .95fr; gap:clamp(2.5rem, 6vw, 6rem); align-items:center;}
  .hero-copy h1{margin:1.4rem 0 1.6rem; color:var(--navy); font-weight:500;}
  .hero-copy h1 em{font-style:italic; color:var(--gold); font-weight:500;}
  .hero-actions{display:flex; flex-wrap:wrap; gap:.9rem; margin-top:2.2rem;}
  .hero-stats{display:flex; flex-wrap:wrap; gap:2.8rem; margin-top:3.4rem; padding-top:2rem; border-top:1px solid var(--line);}
  .stat strong{display:block; font-family:var(--serif); font-size:2.1rem; color:var(--navy); line-height:1; font-weight:600;}
  .stat span{font-size:.72rem; letter-spacing:.1em; text-transform:uppercase; color:var(--muted); margin-top:.3rem; display:block;}
  .hero-visual{position:relative;}
  .hero-image{border-radius:var(--radius); overflow:hidden; box-shadow:var(--shadow); aspect-ratio:4/5; background:var(--navy-2); position:relative;}
  .hero-image img{width:100%; height:100%; object-fit:cover;}
  .hero-image::after{content:""; position:absolute; inset:0; background:linear-gradient(180deg, transparent 55%, rgba(10,29,55,.35));}
  .float-card{position:absolute; background:var(--ivory-2); border:1px solid var(--gold-pale); border-radius:var(--radius-sm); box-shadow:var(--shadow-sm); padding:1rem 1.2rem; animation:float 6s ease-in-out infinite;}
  @keyframes float{0%,100%{transform:translateY(0);} 50%{transform:translateY(-8px);}}
  .float-card.one{left:-1.8rem; top:12%; max-width:220px;}
  .float-card.two{right:-1.4rem; bottom:16%; max-width:230px; animation-delay:-3s;}
  .float-card strong{display:block; font-family:var(--serif); font-size:1.5rem; color:var(--navy); line-height:1;}
  .float-card span{font-size:.7rem; color:var(--muted); display:block; margin-top:.25rem; letter-spacing:.03em;}
  .float-card .stars{color:var(--gold); font-size:.8rem; letter-spacing:.1em; margin-top:.3rem;}

  section{padding:clamp(4rem, 8vw, 7rem) 0; position:relative;}
  .section-head{display:flex; align-items:flex-end; justify-content:space-between; gap:2rem; margin-bottom:3rem;}
  .section-head h2{color:var(--navy); margin-top:.8rem;}
  .section-head p{max-width:540px; margin-top:.9rem;}
  .bg-ivory-2{background:var(--ivory-2);}
  .bg-navy{background:var(--navy); color:var(--ivory); position:relative; overflow:hidden;}
  .bg-navy::before{content:""; position:absolute; left:-10%; bottom:-40%; width:50vw; height:50vw; background:radial-gradient(circle, rgba(176,141,87,.18), transparent 65%); pointer-events:none;}
  .bg-navy h2,.bg-navy h3{color:var(--ivory);}
  .bg-navy p{color:rgba(247,243,235,.72);}
  .bg-navy .eyebrow{color:var(--gold-soft);}
  .bg-navy .eyebrow::before,.bg-navy .eyebrow::after{background:var(--gold-soft);}

  .grid-3{display:grid; grid-template-columns:repeat(3,1fr); gap:1.6rem;}
  .grid-2{display:grid; grid-template-columns:repeat(2,1fr); gap:1.6rem;}
  .grid-4{display:grid; grid-template-columns:repeat(4,1fr); gap:1.4rem;}

  .card{background:var(--white); border:1px solid var(--line); border-radius:var(--radius); overflow:hidden; display:flex; flex-direction:column; position:relative; transition:transform .4s cubic-bezier(.16,1,.3,1), box-shadow .4s, border-color .4s; will-change:transform;}
  .card::after{content:""; position:absolute; inset:0; border-radius:var(--radius); border:1px solid transparent; transition:border-color .4s; pointer-events:none;}
  .card:hover{transform:translateY(-8px); box-shadow:var(--shadow);}
  .card:hover::after{border-color:rgba(176,141,87,.4);}
  .card-media{aspect-ratio:16/10; overflow:hidden; background:var(--navy-2); position:relative; display:block;}
  .card-media img{width:100%; height:100%; object-fit:cover; transition:transform .7s cubic-bezier(.16,1,.3,1);}
  .card:hover .card-media img{transform:scale(1.06);}
  .badge{position:absolute; top:1rem; left:1rem; background:rgba(247,243,235,.95); color:var(--navy); font-size:.62rem; font-weight:600; letter-spacing:.1em; text-transform:uppercase; padding:.4rem .75rem; border-radius:999px; backdrop-filter:blur(6px);}
  .badge.gold{background:var(--gold); color:#fff;}
  .card-body{padding:1.5rem; display:flex; flex-direction:column; flex:1;}
  .card-meta{display:flex; flex-wrap:wrap; gap:.7rem; font-size:.72rem; color:var(--muted); margin-bottom:.7rem; align-items:center;}
  .card-title{font-family:var(--serif); font-size:1.4rem; color:var(--navy); line-height:1.18; margin-bottom:.55rem; font-weight:600;}
  .card-title a:hover{color:var(--gold);}
  .card-desc{font-size:.86rem; color:var(--muted); line-height:1.65; margin-bottom:1.2rem;}
  .card-foot{margin-top:auto; display:flex; align-items:center; justify-content:space-between; gap:1rem; padding-top:1rem; border-top:1px solid var(--line);}
  .price{font-family:var(--serif); font-size:1.4rem; color:var(--navy); font-weight:600;}
  .price small{font-family:var(--sans); font-size:.65rem; color:var(--muted); font-weight:400;}
  .rating{font-size:.76rem; color:var(--muted); display:inline-flex; align-items:center; gap:.3rem;}
  .rating b{color:var(--navy);}
  .gold-star{color:var(--gold);}

  .quick-view{position:absolute; top:1rem; right:1rem; z-index:2; width:38px; height:38px; border-radius:50%; background:rgba(247,243,235,.95); display:grid; place-items:center; opacity:0; transform:scale(.8); transition:opacity .3s, transform .3s, background .2s; color:var(--navy); backdrop-filter:blur(6px);}
  .card:hover .quick-view, .quick-view:focus-visible{opacity:1; transform:scale(1);}
  .quick-view:hover{background:var(--gold); color:#fff;}
  @media (hover:none){ .quick-view{opacity:1; transform:none;} }

  .filter-bar{background:var(--white); border:1px solid var(--line); border-radius:var(--radius); padding:1.1rem; display:grid; grid-template-columns:1.7fr 1fr 1fr 1fr 1fr; gap:.7rem; box-shadow:var(--shadow-sm); margin-bottom:2.2rem;}
  .field label{display:block; font-size:.62rem; letter-spacing:.12em; text-transform:uppercase; color:var(--muted); margin-bottom:.32rem; font-weight:600;}
  .field input,.field select,.field textarea{width:100%; background:var(--ivory-2); border:1px solid var(--line); border-radius:10px; padding:.72rem .85rem; color:var(--ink); font-size:.85rem; transition:border-color .2s, box-shadow .2s, background .2s;}
  .field input:focus,.field select:focus,.field textarea:focus{border-color:var(--gold); outline:none; box-shadow:0 0 0 3px rgba(176,141,87,.14); background:var(--white);}
  .result-count{text-align:center; margin-top:2rem; font-size:.8rem; color:var(--muted);}

  .featured-post{display:grid; grid-template-columns:1.1fr .9fr; overflow:hidden; background:var(--white); border:1px solid var(--line); border-radius:var(--radius); margin-bottom:2.4rem; box-shadow:var(--shadow-sm);}
  .featured-post .media{min-height:380px; background:var(--navy-2); overflow:hidden;}
  .featured-post .media img{width:100%; height:100%; object-fit:cover; transition:transform .8s cubic-bezier(.16,1,.3,1);}
  .featured-post:hover .media img{transform:scale(1.04);}
  .featured-post .body{padding:clamp(2rem, 4vw, 3.4rem); display:flex; flex-direction:column; justify-content:center;}
  .featured-post h2{color:var(--navy); margin:.8rem 0 1rem; font-size:clamp(1.7rem, 3vw, 2.5rem); font-weight:600;}
  .post-meta{display:flex; flex-wrap:wrap; gap:.9rem; font-size:.74rem; color:var(--muted); align-items:center;}
  .post-meta .dot{width:4px; height:4px; border-radius:50%; background:var(--gold);}
  .tag{display:inline-block; font-size:.64rem; letter-spacing:.08em; text-transform:uppercase; color:var(--navy); background:var(--gold-pale); padding:.32rem .7rem; border-radius:999px; font-weight:600;}

  .reading-progress{position:fixed; top:88px; left:0; height:3px; background:linear-gradient(90deg,var(--gold),var(--gold-soft)); width:0; z-index:70; transition:width .1s linear;}

  .article-hero{padding:clamp(2.5rem,5vw,4.5rem) 0 2rem;}
  .breadcrumbs{display:flex; flex-wrap:wrap; gap:.5rem; font-size:.73rem; color:var(--muted); margin-bottom:1.4rem; align-items:center;}
  .breadcrumbs a:hover{color:var(--gold);}
  .breadcrumbs span{color:var(--line-strong);}
  .article-layout{display:grid; grid-template-columns:minmax(0,1fr) 300px; gap:4rem; align-items:start;}
  .article-body{font-size:1.05rem; line-height:1.9; color:#39465A;}
  .article-body h2{font-size:1.95rem; color:var(--navy); margin:2.6rem 0 1rem; scroll-margin-top:120px; font-weight:600;}
  .article-body h3{font-size:1.4rem; color:var(--navy); margin:2rem 0 .8rem; font-weight:600;}
  .article-body p{margin-bottom:1.2rem; color:#39465A;}
  .article-body ul,.article-body ol{margin:0 0 1.3rem 1.3rem; color:#39465A;}
  .article-body li{margin-bottom:.5rem;}
  .article-body blockquote{border-left:3px solid var(--gold); background:var(--ivory-2); padding:1.3rem 1.6rem; margin:1.8rem 0; font-family:var(--serif); font-size:1.3rem; color:var(--navy); line-height:1.5; border-radius:0 var(--radius-sm) var(--radius-sm) 0; font-style:italic; font-weight:500;}
  .toc{position:sticky; top:120px; background:var(--white); border:1px solid var(--line); border-radius:var(--radius); padding:1.4rem;}
  .toc h4{font-family:var(--sans); font-size:.66rem; letter-spacing:.16em; text-transform:uppercase; color:var(--muted); margin-bottom:.9rem; font-weight:600;}
  .toc a{display:block; font-size:.8rem; color:var(--muted); padding:.38rem .7rem; border-left:2px solid transparent; transition:color .2s, border-color .2s, background .2s; border-radius:0 6px 6px 0;}
  .toc a:hover{color:var(--navy); background:var(--ivory-2);}
  .toc a.active{color:var(--navy); border-left-color:var(--gold); font-weight:600; background:var(--ivory-2);}
  .article-actions{display:flex; flex-wrap:wrap; gap:.6rem; margin:2rem 0; padding:1.2rem 0; border-block:1px solid var(--line);}
  .bookmark-btn .heart{display:inline-block; transition:transform .3s;}
  .bookmark-btn.saved .heart{transform:scale(1.2);}
  .bookmark-btn.saved{color:var(--gold); border-color:var(--gold);}
  .disclaimer{background:var(--gold-pale); border:1px solid rgba(176,141,87,.3); border-radius:var(--radius-sm); padding:1.3rem 1.5rem; font-size:.83rem; color:#5B4A2F; margin-top:2.5rem; line-height:1.7;}

  .dash-grid{display:grid; grid-template-columns:300px minmax(0,1fr); gap:2rem; align-items:start;}
  .side-card{background:var(--white); border:1px solid var(--line); border-radius:var(--radius); padding:1.5rem; box-shadow:var(--shadow-sm);}
  .lesson-row{display:flex; align-items:center; gap:.9rem; padding:.9rem 0; border-bottom:1px solid var(--line);}
  .lesson-row:last-child{border-bottom:0;}
  .lesson-check{width:28px; height:28px; border-radius:50%; border:1.5px solid var(--line-strong); display:grid; place-items:center; flex-shrink:0; background:var(--ivory-2); font-size:.7rem; color:transparent; transition:all .3s;}
  .lesson-check:hover{border-color:var(--gold);}
  .lesson-check.done{background:var(--gold); border-color:var(--gold); color:#fff; transform:scale(1.05);}
  .progress-track{height:8px; border-radius:999px; background:rgba(10,29,55,.1); overflow:hidden;}
  .progress-fill{height:100%; background:linear-gradient(90deg,var(--gold),var(--gold-soft)); border-radius:999px; transition:width .5s cubic-bezier(.16,1,.3,1);}
  .quiz-card{background:var(--ivory-2); border:1px solid var(--line); border-radius:var(--radius-sm); padding:1.5rem; margin-top:1.5rem;}
  .quiz-option{display:flex; gap:.65rem; align-items:flex-start; padding:.6rem .8rem; font-size:.88rem; color:#39465A; border-radius:8px; cursor:pointer; transition:background .2s;}
  .quiz-option:hover{background:rgba(176,141,87,.08);}
  .certificate{margin-top:1.6rem; border:1.5px solid var(--gold); border-radius:var(--radius); padding:2rem; text-align:center; position:relative; overflow:hidden; background:linear-gradient(180deg,var(--ivory-2),var(--white));}
  .certificate::before{content:""; position:absolute; inset:8px; border:1px solid rgba(176,141,87,.35); border-radius:calc(var(--radius) - 6px); pointer-events:none;}
  .admin-tabs{display:flex; gap:.5rem; flex-wrap:wrap; margin-bottom:1.8rem;}
  .tab-btn{background:transparent; border:1px solid var(--line-strong); border-radius:999px; padding:.58rem 1.15rem; font-size:.8rem; font-weight:600; color:var(--navy); transition:all .25s;}
  .tab-btn.active{background:var(--navy); color:var(--ivory); border-color:var(--navy);}
  .tab-btn:hover:not(.active){border-color:var(--navy);}
  .admin-list{display:grid; gap:.8rem;}
  .admin-row{background:var(--white); border:1px solid var(--line); border-radius:var(--radius-sm); padding:1rem 1.2rem; display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap; transition:border-color .2s, box-shadow .2s;}
  .admin-row:hover{border-color:rgba(176,141,87,.4); box-shadow:var(--shadow-sm);}
  .admin-row h4{font-family:var(--sans); font-size:.92rem; font-weight:600; color:var(--navy); margin:0;}
  .admin-row p{font-size:.74rem; margin:.25rem 0 0;}
  .status{font-size:.62rem; letter-spacing:.08em; text-transform:uppercase; font-weight:700; padding:.3rem .65rem; border-radius:999px;}
  .status.published{background:#E3F0E5; color:#245B31;}
  .status.draft{background:#F3E9D7; color:#7A5A20;}
  .form-grid{display:grid; grid-template-columns:1fr 1fr; gap:1rem;}
  .form-grid .full{grid-column:1/-1;}

  .team-card{background:var(--white); border:1px solid var(--line); border-radius:var(--radius); overflow:hidden; display:flex; flex-direction:column; cursor:pointer; transition:transform .4s cubic-bezier(.16,1,.3,1), box-shadow .4s, border-color .4s; text-align:center; padding:2rem 1.4rem 1.5rem;}
  .team-card:hover{transform:translateY(-8px); box-shadow:var(--shadow); border-color:rgba(176,141,87,.4);}
