      return matchesQ && matchesCat && matchesLevel && matchesPrice;
    });
    if(courseFilters.sort==='popular') list.sort((a,b)=>b.students-a.students);
    if(courseFilters.sort==='priceLow') list.sort((a,b)=>a.price-b.price);
    if(courseFilters.sort==='rating') list.sort((a,b)=>b.rating-a.rating);
    $('#courseResults').innerHTML = list.length
      ? `<div class="grid-3">${list.map(courseCard).join('')}</div><p class="result-count">Showing ${list.length} of ${getCourses().filter(c=>c.published!==false).length} courses</p>`
      : `<div class="empty"><h3>No courses match those filters.</h3><p>Try clearing the search or choosing a different category.</p><button class="btn btn-outline" id="clearCourseFilters" style="margin-top:1rem;">Clear Filters</button></div>`;
