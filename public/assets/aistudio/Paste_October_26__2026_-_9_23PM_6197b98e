    if(clear) clear.onclick = ()=>{ courseFilters = { q:'', category:'', level:'', price:'', sort:'newest' }; renderCoursesPage(); };
    attachCardHandlers($('#courseResults'));
    observeReveals($('#courseResults'));
    attachMagnetic($('#courseResults'));
  };

  $('#courseSearch').oninput = e => { courseFilters.q = e.target.value; render(); };
  $('#courseCategory').onchange = e => { courseFilters.category = e.target.value; render(); };
  $('#courseLevel').onchange = e => { courseFilters.level = e.target.value; render(); };
  $('#coursePrice').onchange = e => { courseFilters.price = e.target.value; render(); };
  $('#courseSort').onchange = e => { courseFilters.sort = e.target.value; render(); };
  observeReveals();
  render();
}

