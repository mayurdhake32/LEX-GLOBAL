      const matchesQ = !q || [p.title,p.subtitle,p.author,p.category,(p.tags||[]).join(' ')].join(' ').toLowerCase().includes(q);
      const matchesCat = !blogFilters.category || p.category===blogFilters.category;
      const matchesTag = !blogFilters.tag || (p.tags||[]).includes(blogFilters.tag);
      let matchesDate = true;
      if(blogFilters.date){
        const d = new Date(p.date); const now = new Date();
        if(blogFilters.date==='recent') matchesDate = (now-d)/(1000*60*60*24) <= 90;
        if(blogFilters.date==='year') matchesDate = d.getFullYear() === now.getFullYear();
      }
      return matchesQ && matchesCat && matchesTag && matchesDate;
    });
    list.sort((a,b)=>new Date(b.date)-new Date(a.date));
