  const results = $('#cmdkResults');
  if(!cmdkItems.length){ results.innerHTML = `<div class="cmdk-empty">No results for “${esc(q)}”. Try a course, article, or team member.</div>`; return; }
  const groups = {};
  cmdkItems.forEach((it, i)=>{ const g = it.sub.split(' · ')[0]; (groups[g] = groups[g] || []).push({ ...it, _i:i }); });
  let html = '';
  Object.keys(groups).forEach(g=>{
    html += `<div class="cmdk-group-label">${esc(g)}</div>`;
    groups[g].forEach(it=>{
      html += `<div class="cmdk-item ${it._i===0?'selected':''}" data-cmdk="${it._i}"><span class="cmdk-item-icon">${it.icon}</span><div><div class="cmdk-item-title">${esc(it.title)}</div><div class="cmdk-item-sub">${esc(it.sub)}</div></div></div>`;
    });
  });
  results.innerHTML = html;
  $$('.cmdk-item', results).forEach(el=>{
    el.addEventListener('click', ()=>{ navigateCmdk(Number(el.dataset.cmdk)); });
    el.addEventListener('mouseenter', ()=>{ $$('.cmdk-item', results).forEach(x=>x.classList.remove('selected')); el.classList.add('selected'); });
  });
