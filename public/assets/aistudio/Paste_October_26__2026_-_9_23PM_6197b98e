    </div>
  </section>
  <section style="padding-top:1rem;">
    <div class="wrap" style="max-width:980px;">
      <div class="reveal" style="border-radius:var(--radius); overflow:hidden; margin-bottom:3rem; box-shadow:var(--shadow-sm);"><img src="${esc(p.image)}" alt="${esc(p.title)}" style="width:100%; max-height:520px; object-fit:cover;"></div>
      <div class="article-layout">
        <article class="reveal d1">
          <div class="article-actions">
            <a class="btn btn-outline btn-sm" href="https://twitter.com/intent/tweet?text=${encodeURIComponent(p.title)}&url=${encodeURIComponent(location.href)}" target="_blank" rel="noopener">Share on X</a>
            <a class="btn btn-outline btn-sm" href="https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(location.href)}" target="_blank" rel="noopener">Share on LinkedIn</a>
