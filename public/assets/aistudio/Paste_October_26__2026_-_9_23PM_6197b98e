        ${!usingAir ? `<button class="btn btn-outline btn-sm" id="seedLocal">Seed Sample Blogs</button>` : ''}
      </div>

      <div style="display:flex; justify-content:space-between; align-items:center; gap:1rem; flex-wrap:wrap; margin-top:1.8rem;">
        <h3 style="color:var(--navy); margin:0;">Articles</h3>
        <button class="btn btn-primary" id="newBlogBtn">+ New Article</button>
      </div>
      <div id="blogManagerList" style="margin-top:1.2rem;">
        <p style="text-align:center; padding:2rem; color:var(--muted);">Loading articles…</p>
      </div>

      <div class="disclaimer" style="margin-top:2rem;">
        <strong>Prototype notice:</strong> Airtable credentials are stored in this browser only. For production, proxy Airtable requests through a server function so the API key is never exposed.
      </div>
    </div>
  </section>`;

  observeReveals();
  attachMagnetic();

  $('#blogLogout').onclick = () => {
    setBlogAuthed(false);
    toast('Locked.');
    renderManageBlogs();
  };
  $('#airtableSettings').onclick = () => openAirtableSettingsModal();
  const testBtn = $('#airtableTest');
  if(testBtn) testBtn.onclick = async () => {
    testBtn.textContent = 'Testing…'; testBtn.disabled = true;
    try{
      const list = await airtableList();
      toast(`✓ Connected. Found ${list.length} record${list.length === 1 ? '' : 's'} in Airtable.`);
    }catch(e){
      toast('Connection failed: ' + e.message);
    }
    testBtn.textContent = 'Test Connection'; testBtn.disabled = false;
  };
  const pullBtn = $('#airtablePull');
  if(pullBtn) pullBtn.onclick = async () => {
    pullBtn.textContent = 'Pulling…'; pullBtn.disabled = true;
    await refreshAirtableCache();
    toast(airtableLastError ? 'Pull failed: ' + airtableLastError : 'Airtable cache refreshed.');
    loadBlogManagerList();
    pullBtn.textContent = 'Pull from Airtable'; pullBtn.disabled = false;
  };
  const seedBtn = $('#seedLocal');
  if(seedBtn) seedBtn.onclick = () => {
    if(!confirm('This will add sample blogs to local storage. Continue?')) return;
    const current = load(STORE.posts, []);
    const merged = [...defaultPosts.filter(dp => !current.some(cp => cp.slug === dp.slug)), ...current];
    save(STORE.posts, merged);
    toast('Sample blogs seeded to local storage.');
    loadBlogManagerList();
  };
  $('#newBlogBtn').onclick = () => openBlogEditor(null);

  loadBlogManagerList();
}

async function loadBlogManagerList(){
  const el = $('#blogManagerList');
  if(!el) return;
  const cfg = getAirtableConfig();
  const usingAir = cfg.enabled && cfg.apiKey && cfg.baseId;
  let posts = [];
  let source = 'local';

  if(usingAir){
    el.innerHTML = '<p style="text-align:center; padding:2rem; color:var(--muted);">Fetching from Airtable…</p>';
    try{
      posts = await airtableList();
      airtablePostsCache = posts;
      airtableLastError = null;
      source = 'airtable';
    }catch(e){
      airtableLastError = e.message;
      posts = load(STORE.posts, defaultPosts);
      source = 'fallback';
    }
  } else {
    posts = load(STORE.posts, defaultPosts);
  }

  if(!posts.length){
    el.innerHTML = `<div class="empty"><h3>No articles yet.</h3><p>Create your first article to see it appear on the Legal Hub.</p></div>`;
    return;
  }

  const sourceLabel = source === 'airtable' ? 'from Airtable' : source === 'fallback' ? 'from local storage (Airtable unavailable)' : 'from local storage';
  el.innerHTML = `
    <p style="font-size:.78rem; color:var(--muted); margin-bottom:1rem;">${posts.length} article${posts.length === 1 ? '' : 's'} · ${sourceLabel}</p>
    ${airtableLastError ? `<div class="disclaimer" style="margin-bottom:1rem;"><strong>Airtable error:</strong> ${esc(airtableLastError)}</div>` : ''}
    <div class="admin-list">
      ${posts.map(p => `
        <div class="admin-row">
          <div style="flex:1; min-width:220px;">
            <h4>${esc(p.title)}</h4>
            <p>${esc(p.category)} · ${esc(p.author)} · ${formatDate(p.date)}${p._airtable ? ' · Airtable record' : ''}</p>
          </div>
          <div style="display:flex; gap:.4rem; flex-wrap:wrap;">
            <span class="status ${p.published !== false ? 'published' : 'draft'}">${p.published !== false ? 'Published' : 'Draft'}</span>
            <button type="button" class="btn btn-outline btn-sm" data-toggle-blog="${esc(p.id)}">${p.published !== false ? 'Unpublish' : 'Publish'}</button>
            <a href="#/blog/${esc(p.slug)}" class="btn btn-outline btn-sm" target="_blank" rel="noopener">View</a>
            <button type="button" class="btn btn-outline btn-sm" data-edit-blog="${esc(p.id)}">Edit</button>
            <button type="button" class="btn btn-outline btn-sm" data-delete-blog="${esc(p.id)}">Delete</button>
          </div>
        </div>`).join('')}
    </div>`;

  $$('[data-edit-blog]').forEach(b => b.onclick = () => {
    const post = posts.find(x => x.id === b.dataset.editBlog);
    if(post) openBlogEditor(post);
  });
  $$('[data-toggle-blog]').forEach(b => b.onclick = async () => {
    const post = posts.find(x => x.id === b.dataset.toggleBlog);
    if(!post) return;
    const newPub = post.published === false;
    try{
      if(usingAir && post._airtable){
        await airtableUpdate(post.id, { [AIRTABLE_FIELDS.published]: newPub });
      } else {
        const localPosts = load(STORE.posts, defaultPosts);
        const idx = localPosts.findIndex(x => x.id === post.id);
        if(idx >= 0){ localPosts[idx].published = newPub; save(STORE.posts, localPosts); }
      }
      await refreshAirtableCache();
      toast(newPub ? 'Article published.' : 'Article unpublished.');
      loadBlogManagerList();
    }catch(e){ toast('Update failed: ' + e.message); }
  });
  $$('[data-delete-blog]').forEach(b => b.onclick = async () => {
    if(!confirm('Delete this article? This cannot be undone.')) return;
    const post = posts.find(x => x.id === b.dataset.deleteBlog);
    if(!post) return;
    try{
      if(usingAir && post._airtable){
        await airtableDelete(post.id);
      } else {
        const localPosts = load(STORE.posts, defaultPosts);
        save(STORE.posts, localPosts.filter(x => x.id !== post.id));
      }
      await refreshAirtableCache();
      toast('Article deleted.');
      loadBlogManagerList();
    }catch(e){ toast('Delete failed: ' + e.message); }
  });
}

function openBlogEditor(post){
  const isEdit = Boolean(post && post.id);
  const p = post || {
    title:'', slug:'', subtitle:'', category:'Legal Updates', tags:[],
    author:'Lex Global Advocacy', date:new Date().toISOString().slice(0,10),
    readTime:'5 min read',
    image:'https://images.unsplash.com/photo-1589829545856-d10d557cf95f?auto=format&fit=crop&w=1400&q=80',
    content:'<p>Write your article introduction here.</p>\n<h2>First section</h2>\n<p>Add your content here.</p>',
    featured:false, published:true, relatedCourse:''
  };
  const categoryOptions = ['Legal Updates','Arbitration','Data & Privacy','Cross-Border Contracts','Consumer Protection','Real Estate','Legal Writing','Legal Awareness','Family Law','Case Law Analysis','Courses and Learning'];
  openModal(`
    <div class="modal-head">
      <div>
        <span class="eyebrow">${isEdit ? 'Edit Article' : 'New Article'}</span>
        <h3 style="color:var(--navy); margin-top:.4rem; font-size:1.4rem;">${isEdit ? esc(p.title) : 'Create a new article'}</h3>
      </div>
      <button class="btn btn-outline btn-sm" data-close aria-label="Close">✕</button>
    </div>
    <div class="modal-body">
      <form id="blogEditorForm" class="form-grid">
        <div class="field full"><label for="ebTitle">Title *</label><input id="ebTitle" name="title" required value="${esc(p.title)}"></div>
        <div class="field full"><label for="ebSlug">Slug (auto from title if blank)</label><input id="ebSlug" name="slug" value="${esc(p.slug)}" placeholder="my-article-slug"></div>
        <div class="field full"><label for="ebSubtitle">Subtitle</label><input id="ebSubtitle" name="subtitle" value="${esc(p.subtitle)}"></div>
        <div class="field"><label for="ebCategory">Category</label>
          <select id="ebCategory" name="category">
            ${categoryOptions.map(c => `<option ${p.category === c ? 'selected' : ''}>${esc(c)}</option>`).join('')}
          </select>
        </div>
        <div class="field"><label for="ebAuthor">Author</label><input id="ebAuthor" name="author" value="${esc(p.author)}" required></div>
        <div class="field"><label for="ebDate">Date</label><input id="ebDate" name="date" type="date" value="${esc(p.date)}"></div>
        <div class="field"><label for="ebReadTime">Read time</label><input id="ebReadTime" name="readTime" value="${esc(p.readTime)}" placeholder="5 min read"></div>
        <div class="field full"><label for="ebTags">Tags (comma separated)</label><input id="ebTags" name="tags" value="${esc((p.tags || []).join(', '))}"></div>
        <div class="field full"><label for="ebImage">Cover image URL</label><input id="ebImage" name="image" value="${esc(p.image)}"></div>
        <div class="field full"><label for="ebContent">Content (HTML allowed)</label><textarea id="ebContent" name="content" rows="12" class="editor-textarea" required>${esc(p.content)}</textarea></div>
        <div class="field"><label class="check-row"><input type="checkbox" name="featured" ${p.featured ? 'checked' : ''}> Featured article</label></div>
        <div class="field"><label class="check-row"><input type="checkbox" name="published" ${p.published !== false ? 'checked' : ''}> Published</label></div>
        <div class="full" style="display:flex; gap:.6rem; padding-top:.8rem; border-top:1px solid var(--line);">
          <button class="btn btn-primary" type="submit" id="blogEditorSubmit">${isEdit ? 'Save Changes' : 'Create Article'}</button>
          <button class="btn btn-outline" type="button" data-close>Cancel</button>
        </div>
      </form>
    </div>
  `);

  $('#blogEditorForm').onsubmit = async (e) => {
    e.preventDefault();
    const submitBtn = $('#blogEditorSubmit');
    submitBtn.disabled = true; submitBtn.textContent = 'Saving…';
    const f = new FormData(e.target);
    const title = (f.get('title') || '').trim();
    const slugInput = (f.get('slug') || '').trim();
    const slug = slugInput || title.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,'');
    const payload = {
      title, slug,
      subtitle: (f.get('subtitle') || '').trim(),
      category: f.get('category') || 'Legal Updates',
      author: (f.get('author') || '').trim(),
      date: f.get('date') || new Date().toISOString().slice(0,10),
      readTime: (f.get('readTime') || '').trim() || '5 min read',
      tags: (f.get('tags') || '').split(',').map(s => s.trim()).filter(Boolean),
      image: (f.get('image') || '').trim(),
      content: f.get('content') || '',
      featured: f.get('featured') === 'on',
      published: f.get('published') === 'on',
      relatedCourse: p.relatedCourse || ''
    };

    const cfg = getAirtableConfig();
    const usingAir = cfg.enabled && cfg.apiKey && cfg.baseId;

    try{
      if(usingAir){
        const fields = postToAirtableFields(payload);
        if(isEdit && p._airtable && p.id && p.id.startsWith('rec')){
          await airtableUpdate(p.id, fields);
        } else {
          await airtableCreate(fields);
        }
      } else {
        const localPosts = load(STORE.posts, defaultPosts);
        if(isEdit){
          const idx = localPosts.findIndex(x => x.id === p.id);
          if(idx >= 0) localPosts[idx] = { ...localPosts[idx], ...payload };
          else localPosts.unshift({ id:'p' + Date.now(), ...payload });
        } else {
          localPosts.unshift({ id:'p' + Date.now(), ...payload });
        }
        save(STORE.posts, localPosts);
      }
      await refreshAirtableCache();
      closeModal();
      toast(usingAir ? (isEdit ? 'Article updated in Airtable.' : 'Article created in Airtable.') : (isEdit ? 'Article updated.' : 'Article created.'));
      if(isBlogAuthed()) renderBlogManagerDashboard();
      else router();
    }catch(err){
      submitBtn.disabled = false; submitBtn.textContent = isEdit ? 'Save Changes' : 'Create Article';
      toast('Save failed: ' + err.message);
    }
  };
}

function openAirtableSettingsModal(){
  const cfg = getAirtableConfig();
  openModal(`
    <div class="modal-head">
      <div><span class="eyebrow">Settings</span><h3 style="color:var(--navy); margin-top:.4rem; font-size:1.4rem;">Airtable & Password</h3></div>
      <button class="btn btn-outline btn-sm" data-close aria-label="Close">✕</button>
    </div>
    <div class="modal-body">
      <form id="airtableSettingsForm" class="form-grid">
        <div class="full">
          <h4 style="font-family:var(--sans); font-size:.7rem; letter-spacing:.14em; text-transform:uppercase; color:var(--muted); margin-bottom:.6rem;">Airtable</h4>
        </div>
        <div class="full"><label class="check-row"><input type="checkbox" name="enabled" ${cfg.enabled ? 'checked' : ''}> Enable Airtable integration</label></div>
        <div class="field full"><label for="asKey">Personal Access Token</label><input id="asKey" name="apiKey" type="password" value="${esc(cfg.apiKey)}" placeholder="pat…" autocomplete="off"></div>
        <div class="field"><label for="asBase">Base ID</label><input id="asBase" name="baseId" value="${esc(cfg.baseId)}" placeholder="app…"></div>
        <div class="field"><label for="asTable">Table name</label><input id="asTable" name="tableName" value="${esc(cfg.tableName || 'Blogs')}"></div>

        <div class="full" style="padding-top:1rem; margin-top:.5rem; border-top:1px solid var(--line);">
          <h4 style="font-family:var(--sans); font-size:.7rem; letter-spacing:.14em; text-transform:uppercase; color:var(--muted); margin-bottom:.6rem;">Change Blog Manager Password</h4>
        </div>
        <div class="field full"><label for="asPwOld">Current password</label><input id="asPwOld" name="pwOld" type="password" placeholder="required to change password"></div>
        <div class="field"><label for="asPwNew">New password</label><input id="asPwNew" name="pwNew" type="password" placeholder="min 8 characters"></div>
        <div class="field"><label for="asPwConfirm">Confirm new password</label><input id="asPwConfirm" name="pwConfirm" type="password"></div>

        <div class="full" style="padding-top:1rem; margin-top:.5rem; border-top:1px solid var(--line);">
          <p style="font-size:.78rem; margin-bottom:.8rem;"><strong>Required Airtable columns:</strong> Title, Slug, Subtitle, Category, Tags, Author, Date, Image, Content, Featured, Published, ReadTime. Content accepts HTML. Create one record per article.</p>
          <div style="display:flex; gap:.6rem; flex-wrap:wrap;">
            <button class="btn btn-primary" type="submit">Save Settings</button>
            <button class="btn btn-outline" type="button" data-close>Cancel</button>
          </div>
        </div>
      </form>
    </div>
  `);

  $('#airtableSettingsForm').onsubmit = (e) => {
    e.preventDefault();
    const f = new FormData(e.target);
    const oldPw = (f.get('pwOld') || '').trim();
    const newPw = (f.get('pwNew') || '').trim();
    const confirmPw = (f.get('pwConfirm') || '').trim();

    if(newPw || oldPw || confirmPw){
      if(oldPw !== getBlogPassword()){ toast('Current password is incorrect.'); return; }
      if(newPw.length < 8){ toast('New password must be at least 8 characters.'); return; }
      if(newPw !== confirmPw){ toast('New password and confirmation do not match.'); return; }
      setBlogPassword(newPw);
      toast('Password updated.');
    }

    const newCfg = {
      enabled: f.get('enabled') === 'on',
      apiKey: (f.get('apiKey') || '').trim(),
      baseId: (f.get('baseId') || '').trim(),
      tableName: (f.get('tableName') || 'Blogs').trim() || 'Blogs'
    };
    setAirtableConfig(newCfg);
    closeModal();
    toast('Settings saved.');
    (async () => {
      await refreshAirtableCache();
      if(isBlogAuthed()) renderBlogManagerDashboard();
      else router();
    })();
  };
}

/* =================== 404 =================== */
function renderNotFound(msg){
  app.innerHTML = `
  <section><div class="wrap" style="max-width:700px;">
    <div class="empty reveal">
      <h1 style="font-size:3rem; color:var(--navy); margin-bottom:.5rem; font-family:var(--serif);">404</h1>
      <h3>${esc(msg || 'Page not found')}</h3>
      <p>The page you are looking for may have moved or no longer exists.</p>
      <a href="#/" class="btn btn-primary" style="margin-top:1.2rem;">Return Home <span class="arrow">→</span></a>
    </div>
  </div></section>`;
  observeReveals(); attachMagnetic();
}

/* =================== ROUTER =================== */
function setActiveNav(path){ $$('.main-nav a').forEach(a=>a.classList.toggle('active', a.dataset.nav === path)); }
function closeMobileNav(){ $('#mobileNav').classList.remove('open'); $('#menuToggle').setAttribute('aria-expanded','false'); }

function router(){
  closeMobileNav();
  if(scrollHandler){ window.removeEventListener('scroll', scrollHandler); scrollHandler = null; }
  if(tocObserver){ tocObserver.disconnect(); tocObserver = null; }
  $('#readingProgress').hidden = true;

  const hash = location.hash.replace(/^#/,'') || '/';
  const [path, queryString] = hash.split('?');
  const params = new URLSearchParams(queryString || '');
  const parts = path.split('/').filter(Boolean);

  window.scrollTo({ top:0, behavior:'instant' });

  if(path === '/' || path === ''){ setActiveNav('/'); renderHome(); return; }
  if(parts[0] === 'courses' && !parts[1]){
    courseFilters = { q:'', category:'', level:'', price:'', sort:'newest' };
    if(params.get('category')) courseFilters.category = params.get('category');
    if(params.get('level')) courseFilters.level = params.get('level');
    setActiveNav('/courses'); renderCoursesPage(); return;
  }
  if(parts[0] === 'course' && parts[1]){ setActiveNav('/courses'); renderCourseDetail(parts[1]); return; }
  if(parts[0] === 'blogs'){
    blogFilters = { q:'', category:'', tag:'', date:'' };
    if(params.get('category')) blogFilters.category = params.get('category');
    if(params.get('tag')) blogFilters.tag = params.get('tag');
    setActiveNav('/blogs'); renderBlogsPage(); return;
  }
  if(parts[0] === 'blog' && parts[1]){ setActiveNav('/blogs'); renderArticle(parts[1]); return; }
  if(parts[0] === 'team' && parts[1]){
    setActiveNav('/team'); renderTeamPage();
    setTimeout(()=>openTeamModal(parts[1]), 300);
    return;
  }
  if(parts[0] === 'team'){ setActiveNav('/team'); renderTeamPage(); return; }
  if(parts[0] === 'learn'){ setActiveNav('/learn'); renderLearn(); return; }
  if(parts[0] === 'admin'){ setActiveNav('/admin'); renderAdmin(); return; }
  if(parts[0] === 'manage-blogs'){ setActiveNav(''); renderManageBlogs(); return; }
  setActiveNav(''); renderNotFound('Page not found');
}

/* =================== GLOBAL EVENTS =================== */
window.addEventListener('hashchange', router);

window.addEventListener('DOMContentLoaded', () => {
  $('#year').textContent = new Date().getFullYear();

  const header = $('#siteHeader');
  window.addEventListener('scroll', ()=>{
    header.classList.toggle('scrolled', window.scrollY > 20);
    $('#backTop').classList.toggle('show', window.scrollY > 600);
  }, { passive:true });

  $('#backTop').onclick = () => window.scrollTo({ top:0, behavior:'smooth' });

  $('#menuToggle').onclick = () => {
    const nav = $('#mobileNav');
    const open = nav.classList.toggle('open');
    $('#menuToggle').setAttribute('aria-expanded', String(open));
  };

  $('#newsletterForm').onsubmit = e => {
    e.preventDefault();
    const email = $('#newsletterEmail').value.trim();
    const msg = $('#newsletterMsg');
    if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){
      msg.textContent = 'Please enter a valid email address.';
      msg.style.color = '#E8B4B4';
      return;
    }
    msg.textContent = 'Thank you — your preference has been saved for this prototype.';
    msg.style.color = 'var(--gold-soft)';
    toast('Subscription preference saved. Server-side consent and unsubscribe flow required in production.');
    e.target.reset();
  };

  $('#cmdkTrigger').onclick = openCmdk;
  $('#cmdkInput').addEventListener('input', e => renderCmdk(e.target.value));
  $('#cmdkOverlay').addEventListener('click', e => { if(e.target.id === 'cmdkOverlay') closeCmdk(); });
  $('#modalOverlay').addEventListener('click', e => { if(e.target.id === 'modalOverlay') closeModal(); });

  document.addEventListener('keydown', e => {
    if((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k'){ e.preventDefault(); cmdkOpen ? closeCmdk() : openCmdk(); return; }
    if(e.key === 'Escape'){ if(cmdkOpen) closeCmdk(); if($('#modalOverlay').classList.contains('open')) closeModal(); }
    if(cmdkOpen){
      if(e.key === 'ArrowDown'){ e.preventDefault(); moveCmdk(1); }
      if(e.key === 'ArrowUp'){ e.preventDefault(); moveCmdk(-1); }
      if(e.key === 'Enter'){ e.preventDefault(); navigateCmdk(cmdkIndex); }
    }
  });

  observeReveals();
  attachMagnetic();
  attachCardHandlers();
  attachTeamHandlers();

  initAirtableBlogs();
  router();
});
</script>
