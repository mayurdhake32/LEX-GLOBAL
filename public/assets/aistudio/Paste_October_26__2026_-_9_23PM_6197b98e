<script>
/* =========================================================
   LEX GLOBAL ADVOCACY — Interactive Courses, Blogs & Team
   ========================================================= */

const STORE = {
  courses:'lga_courses_v1', posts:'lga_posts_v1',
  enrollments:'lga_enrollments_v1', bookmarks:'lga_bookmarks_v1'
};

/* ===== Airtable & Blog Manager ===== */
const AIRTABLE = {
  CONFIG_KEY:'lga_airtable_config_v1',
  AUTH_KEY:'lga_blog_auth_v1',
  PASSWORD_KEY:'lga_blog_password_v1'
};
const DEFAULT_BLOG_PASSWORD = 'lexglobal2026';
const AIRTABLE_FIELDS = {
  title:'Title', slug:'Slug', subtitle:'Subtitle', category:'Category',
  tags:'Tags', author:'Author', date:'Date', image:'Image',
  content:'Content', featured:'Featured', published:'Published', readTime:'ReadTime'
};
let airtablePostsCache = null;
let airtableLastError = null;

function getAirtableConfig(){
  try{
    const raw = localStorage.getItem(AIRTABLE.CONFIG_KEY);
    return raw ? JSON.parse(raw) : { enabled:false, apiKey:'', baseId:'', tableName:'Blogs' };
  }catch(e){ return { enabled:false, apiKey:'', baseId:'', tableName:'Blogs' }; }
}
function setAirtableConfig(cfg){ localStorage.setItem(AIRTABLE.CONFIG_KEY, JSON.stringify(cfg)); }
function getBlogPassword(){ return localStorage.getItem(AIRTABLE.PASSWORD_KEY) || DEFAULT_BLOG_PASSWORD; }
function setBlogPassword(pw){ localStorage.setItem(AIRTABLE.PASSWORD_KEY, pw); }
function isBlogAuthed(){ try{ return sessionStorage.getItem(AIRTABLE.AUTH_KEY) === 'true'; }catch(e){ return false; } }
function setBlogAuthed(v){
  try{ v ? sessionStorage.setItem(AIRTABLE.AUTH_KEY,'true') : sessionStorage.removeItem(AIRTABLE.AUTH_KEY); }catch(e){}
}

function airtableRecordToPost(record){
  const f = record.fields || {};
  const title = f[AIRTABLE_FIELDS.title] || 'Untitled';
  const date = f[AIRTABLE_FIELDS.date] || new Date().toISOString().slice(0,10);
  const tagsRaw = f[AIRTABLE_FIELDS.tags] || '';
  const tags = Array.isArray(tagsRaw) ? tagsRaw : String(tagsRaw).split(',').map(s=>s.trim()).filter(Boolean);
  const pub = f[AIRTABLE_FIELDS.published];
  return {
    id: record.id, _airtable: true, title,
    slug: f[AIRTABLE_FIELDS.slug] || title.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,''),
    subtitle: f[AIRTABLE_FIELDS.subtitle] || '',
    category: f[AIRTABLE_FIELDS.category] || 'General',
    tags,
    author: f[AIRTABLE_FIELDS.author] || 'Lex Global Advocacy',
    date, updated: date,
    readTime: f[AIRTABLE_FIELDS.readTime] || '5 min read',
    image: f[AIRTABLE_FIELDS.image] || 'https://images.unsplash.com/photo-1589829545856-d10d557cf95f?auto=format&fit=crop&w=1400&q=80',
    featured: Boolean(f[AIRTABLE_FIELDS.featured]),
    published: pub === undefined ? true : Boolean(pub),
    relatedCourse: '',
    content: f[AIRTABLE_FIELDS.content] || '<p>No content yet.</p>'
  };
}
function postToAirtableFields(p){
  return {
    [AIRTABLE_FIELDS.title]: p.title,
    [AIRTABLE_FIELDS.slug]: p.slug,
    [AIRTABLE_FIELDS.subtitle]: p.subtitle || '',
    [AIRTABLE_FIELDS.category]: p.category || '',
    [AIRTABLE_FIELDS.tags]: (p.tags || []).join(', '),
    [AIRTABLE_FIELDS.author]: p.author || '',
    [AIRTABLE_FIELDS.date]: p.date || new Date().toISOString().slice(0,10),
    [AIRTABLE_FIELDS.image]: p.image || '',
    [AIRTABLE_FIELDS.content]: p.content || '',
    [AIRTABLE_FIELDS.featured]: Boolean(p.featured),
    [AIRTABLE_FIELDS.published]: p.published !== false,
    [AIRTABLE_FIELDS.readTime]: p.readTime || ''
  };
}
async function airtableRequest(path = '', options = {}){
  const cfg = getAirtableConfig();
  if(!cfg.apiKey || !cfg.baseId) throw new Error('Airtable credentials are not configured.');
  const url = `https://api.airtable.com/v0/${cfg.baseId}/${encodeURIComponent(cfg.tableName || 'Blogs')}${path}`;
  const res = await fetch(url, {
    ...options,
    headers: {
      'Authorization': `Bearer ${cfg.apiKey}`,
      'Content-Type': 'application/json',
      ...(options.headers || {})
    }
  });
  if(!res.ok){
    const body = await res.text();
    throw new Error(`Airtable ${res.status}: ${body.slice(0, 240)}`);
  }
  return res.json();
}
async function airtableList(){
  const data = await airtableRequest('?pageSize=100');
  return (data.records || []).map(airtableRecordToPost);
}
async function airtableCreate(fields){
  const data = await airtableRequest('', { method:'POST', body: JSON.stringify({ fields, typecast: true }) });
  return airtableRecordToPost(data);
}
async function airtableUpdate(recordId, fields){
  const data = await airtableRequest(`/${recordId}`, { method:'PATCH', body: JSON.stringify({ fields, typecast: true }) });
  return airtableRecordToPost(data);
}
async function airtableDelete(recordId){ return airtableRequest(`/${recordId}`, { method:'DELETE' }); }

async function refreshAirtableCache(){
  const cfg = getAirtableConfig();
  if(!cfg.enabled || !cfg.apiKey || !cfg.baseId){ airtablePostsCache = null; airtableLastError = null; return; }
  try{
    airtablePostsCache = await airtableList();
    airtableLastError = null;
  }catch(e){
    airtablePostsCache = null;
    airtableLastError = e.message;
    console.warn('Airtable fetch failed:', e);
  }
}
async function initAirtableBlogs(){
  const cfg = getAirtableConfig();
  if(!cfg.enabled || !cfg.apiKey || !cfg.baseId) return;
  const wasEmpty = !airtablePostsCache;
  await refreshAirtableCache();
  if(wasEmpty && airtablePostsCache && airtablePostsCache.length > 0){
    const path = (location.hash || '#/').replace(/^#/, '').split('?')[0];
    if(path === '/' || path === '' || path.startsWith('/blog') || path.startsWith('/course')){
      router();
    }
  }
}
