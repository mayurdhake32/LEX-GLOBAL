            <button class="btn btn-outline btn-sm" id="printArticle">Print</button>
            <button class="btn ${bookmarked?'btn-gold':'btn-outline'} btn-sm bookmark-btn ${bookmarked?'saved':''}" id="bookmarkBtn"><span class="heart">♥</span> ${bookmarked?'Saved':'Save Article'}</button>
          </div>
          <div class="article-body" id="articleBody">${content}</div>
          <div class="disclaimer"><strong>General information only.</strong> This article provides general legal information and does not constitute individualized legal advice. Laws and procedures change; verify the current position and consult a qualified practitioner for your specific circumstances.</div>
        </article>
        <aside class="reveal d2">
          <div class="toc"><h4>On this page</h4>${headings.map((h,i)=>`<a href="#section-${i}" data-toc="${i}">${esc(h.textContent)}</a>`).join('')}</div>
        </aside>
      </div>
      ${relatedCourse ? `<div class="side-card reveal" style="margin-top:3rem; display:flex; align-items:center; justify-content:space-between; gap:1.5rem; flex-wrap:wrap; border-color:rgba(176,141,87,.4);"><div><span class="eyebrow">Related Course</span><h3 style="color:var(--navy); margin-top:.5rem;">${esc(relatedCourse.title)}</h3><p style="font-size:.85rem; margin-top:.3rem;">${esc(relatedCourse.description)}</p></div><a href="#/course/${esc(relatedCourse.slug)}" class="btn btn-primary">Explore Course <span class="arrow">→</span></a></div>` : ''}
      <div style="margin-top:4rem;"><div class="section-head"><div class="reveal"><span class="eyebrow">Continue Reading</span><h2 style="font-size:clamp(1.8rem,3vw,2.4rem);">Related articles</h2></div></div><div class="grid-3">${related.map(postCard).join('') || '<p>No related articles yet.</p>'}</div></div>
    </div>
  </section>`;

  $('#copyLink').onclick = async () => { try{ await navigator.clipboard.writeText(location.href); toast('Link copied to clipboard.'); }catch(e){ toast('Unable to copy. Please copy the URL manually.'); } };
  $('#printArticle').onclick = () => window.print();
  $('#bookmarkBtn').onclick = () => { let b = getBookmarks(); if(b.includes(p.id)){ b = b.filter(x=>x!==p.id); toast('Article removed from your reading list.'); } else { b.push(p.id); toast('Article saved to your reading list.'); } setBookmarks(b); renderArticle(slug); };

  const progress = $('#readingProgress');
  progress.hidden = false;
  progress.style.width = '0%';
  if(scrollHandler) window.removeEventListener('scroll', scrollHandler);
