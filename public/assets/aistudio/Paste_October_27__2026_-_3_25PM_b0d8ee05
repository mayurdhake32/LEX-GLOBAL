<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="LEX GLOBAL ADVOCACY — A full-service law firm with experienced attorneys handling a broad range of complex legal issues.">
<title>LEX GLOBAL ADVOCACY | Full-Service Law Firm</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hind:wght@300;400;500;600;700&family=Prompt:wght@500;600;700&family=Unna:ital,wght@0,400;0,700;1,400&family=Playfair+Display:ital,wght@1,700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css">

<style>
/* ============================================================
   LEX GLOBAL ADVOCACY — All-in-One Stylesheet
   ============================================================ */
:root{
  --primary:#f5c00c; --primary-dark:#c99b00; --black:#000; --white:#fff;
  --gray-light:#ececec; --gray-mid:#c7c7c7; --gray-dark:#171818; --text:#000;
  --font-body:'Hind',sans-serif; --font-serif:'Unna',serif;
  --font-accent:'Prompt',sans-serif; --font-display:'Playfair Display',serif;
}
*,*::before,*::after{box-sizing:border-box;}
html{-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;}
body{margin:0;font-family:var(--font-body);font-size:16px;line-height:2;letter-spacing:1px;color:var(--text);background:var(--white);}
img{display:block;max-width:100%;height:auto;}
a{color:var(--primary);text-decoration:none;transition:color .25s ease-in-out,background-color .25s ease-in-out;}
a:hover,a:focus{color:var(--black);}
h1,h2,h3,h4,h5,h6{margin:0 0 .5rem;font-family:var(--font-serif);font-weight:400;line-height:1.1;}
h1{font-size:2.2rem;} h2{font-size:2rem;} h3{font-weight:700;font-size:1.6rem;}
h4{font-weight:500;letter-spacing:2px;text-transform:uppercase;font-size:1.35rem;}
p{margin:0 0 1.25rem;line-height:2;}
ul,ol{margin:0;padding:0;list-style:none;}
button{font-family:inherit;cursor:pointer;border:0;background:none;}

.visually-hidden{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;}
.hide-for-small-only{display:none;} .show-for-small-only{display:block;}
@media(min-width:40em){.hide-for-small-only{display:block;} .show-for-small-only{display:none;}}

#skiptocontent{position:fixed;top:0;left:0;z-index:10000;padding:8px 12px;background:var(--black);color:var(--white);transform:translateY(-100%);opacity:0;transition:200ms ease-out;}
#skiptocontent:focus{transform:translateY(0);opacity:1;}

.wrapper{width:100%;max-width:100%;overflow:hidden;font-size:20px;}
.grid-container{width:100%;max-width:100%;padding-right:118px;padding-left:118px;margin:0 auto;}
@media(max-width:1499px){.grid-container{padding-right:15px;padding-left:15px;}}

.button{position:relative;display:inline-flex;align-items:center;justify-content:center;height:43px;padding:7px 35px 4px;font-family:var(--font-body);font-weight:700;font-size:16px;color:#222;text-transform:uppercase;text-align:center;white-space:nowrap;background:#bbbfc2;border:0;border-radius:0;overflow:hidden;z-index:1;transition:color .25s ease-in-out,background-color .25s ease-in-out;}
.button::before{content:'';position:absolute;top:0;left:0;z-index:-1;width:5px;height:100%;background:var(--primary);transition:width .25s ease-in-out;}
.button:hover,.button:focus{color:#222;text-decoration:none;}
.button:hover::before,.button:focus::before{width:100%;}

.animate{visibility:hidden;}
.animate.is-animated{visibility:visible;animation:fadeIn .8s ease-out forwards;}
@keyframes fadeIn{from{opacity:0;} to{opacity:1;}}

/* ---------- HEADER ---------- */
.header{position:fixed;top:0;right:0;left:0;z-index:999;display:flex;align-items:center;justify-content:space-between;padding-top:14px;padding-bottom:14px;line-height:1.3;background:transparent;transition:background .25s ease-in-out,padding .25s ease-in-out;box-shadow:inset 0 270px 100px -200px rgba(0,0,0,0.9);}
.header.is-fixed{background:var(--black);padding-top:8px;padding-bottom:8px;}
.header .logo{display:block;color:var(--white);}
.logo-text{display:block;font-family:var(--font-accent);font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--white);line-height:1;}
.logo-text .logo-mark{display:block;font-size:26px;color:var(--white);}
.logo-text .logo-sub{display:block;margin-top:6px;font-size:14px;font-weight:500;letter-spacing:6px;color:var(--primary);}
.logo-text::before{content:'';display:block;width:48px;height:3px;background:var(--primary);margin-bottom:10px;}
.header .right{display:flex;flex-direction:column;align-items:flex-end;gap:8px;}
.header .tools{display:flex;align-items:center;gap:16px;padding-right:8px;}
.header .tools .search,.header .tools .toggle{display:inline-flex;align-items:center;justify-content:center;width:45px;height:42px;color:var(--white);border:3px solid #d9d9d9;transition:color .25s,border-color .25s;}
.header .tools .search:hover,.header .tools .search:focus,.header .tools .toggle:hover,.header .tools .toggle:focus{color:var(--primary);border-color:var(--primary);}
.header .tools .tel{display:inline-flex;align-items:center;gap:14px;min-height:42px;color:var(--white);font-weight:600;font-size:24px;}
.header .tools .tel:hover{color:var(--white);}
.header .tools .tel i{position:relative;color:var(--white);font-size:18px;padding-right:20px;margin-right:6px;}
.header .tools .tel i::after{content:'';position:absolute;top:50%;right:0;width:4px;height:40px;background:var(--gray-mid);transform:translateY(-50%);}
.header .tools .toggle{display:none;}
.header nav{width:100%;}
.header nav > ul{display:flex;justify-content:flex-end;margin:0;padding:0;list-style:none;}
.header nav > ul > li{position:relative;margin-left:26px;}
.header nav > ul > li:first-child{margin-left:0;}
.header nav > ul > li > a{position:relative;display:block;padding:6px 0;font-weight:600;font-size:16px;color:var(--white);line-height:1.3;}
.header nav > ul > li > a::after{content:'';position:absolute;bottom:-6px;left:50%;width:38px;height:4px;background:var(--white);transform:translateX(-50%);opacity:0;visibility:hidden;transition:opacity .25s ease-in-out;}
.header nav > ul > li:hover > a,.header nav > ul > li:focus-within > a,.header nav > ul > li.is-active > a{color:var(--primary);}
.header nav > ul > li:hover > a::after,.header nav > ul > li:focus-within > a::after,.header nav > ul > li.is-active > a::after{opacity:1;visibility:visible;}
.header nav .sub-menu{position:absolute;top:100%;left:-32px;display:none;width:405px;margin:0;padding:12px 0;background:var(--black);z-index:999;}
.header nav li:hover > .sub-menu,.header nav li:focus-within > .sub-menu{display:block;}
.header nav .sub-menu li{margin:0;}
.header nav .sub-menu a{display:block;padding:8px 20px;font-size:14px;color:var(--white);}
.header nav .sub-menu a:hover{color:var(--primary);background:rgba(255,255,255,0.05);}
.search-bar{display:none;position:relative;width:100%;padding:40px;background:var(--black);z-index:2;}
.search-bar.is-open{display:block;}
.search-bar form{position:relative;}
.search-bar .close-it{position:absolute;top:-30px;right:0;font-size:20px;}
.search-bar .close-it a{color:var(--white);}
.search-bar input[type="text"]{width:100%;height:50px;padding:8px;font-size:22px;color:var(--white);background:transparent;border:0;border-bottom:1px solid #cacaca;}
.search-bar input[type="text"]::placeholder{color:var(--white);opacity:1;}
.search-bar button[type="submit"]{position:absolute;top:0;right:0;padding:8px 0;font-size:22px;color:var(--white);}
@media(max-width:1023px){
  .header nav{display:none;}
  .header nav.is-open{display:block;position:fixed;top:0;right:0;width:80%;max-width:400px;height:100vh;padding:80px 24px 24px;background:var(--primary);overflow-y:auto;z-index:998;}
  .header nav.is-open > ul{flex-direction:column;}
  .header nav.is-open > ul > li{margin:0;border-bottom:1px solid rgba(255,255,255,0.3);}
  .header nav.is-open > ul > li > a{padding:14px 0;color:var(--white);font-size:20px;}
  .header nav.is-open > ul > li > a::after{display:none;}
  .header nav.is-open .sub-menu{position:static;display:block;width:100%;padding:0 0 0 16px;background:transparent;}
  .header nav.is-open .sub-menu a{color:var(--white);font-size:14px;padding:6px 0;}
  .header .tools .toggle{display:inline-flex;}
  .header .tools .tel span{display:none;}
  .header .tools .tel i{font-size:22px;margin-right:0;padding-right:0;}
  .header .tools .tel i::after{display:none;}
}

/* ---------- HERO SLIDER ---------- */
.slider{position:relative;height:100vh;min-height:100vh;margin:0;overflow:hidden;}
.main-slider{height:100vh;}
.main-slider .slide{position:relative;height:100vh;min-height:100vh;overflow:hidden;padding:200px 0;box-sizing:border-box;}
.slide-media{position:absolute;inset:0;z-index:0;}
.slide-media img{width:100%;height:100%;object-fit:cover;object-position:left center;}
.main-slider article{position:absolute;top:50%;left:0;right:0;z-index:1;display:flex;justify-content:flex-end;transform:translateY(-50%);}
.slider-heading{display:block;width:100%;max-width:758px;padding:38px 0 45px 48px;font-family:var(--font-body);font-weight:600;font-size:60px;line-height:.99;color:var(--white);text-transform:uppercase;border-left:5px solid var(--primary);}
.slider-heading > span{display:block;font-size:118%;color:var(--primary);}
.slider-tools{position:absolute;bottom:0;left:0;right:0;z-index:2;display:flex;align-items:center;justify-content:space-between;min-height:90px;padding-bottom:20px;color:var(--white);}
.slider-info{display:flex;flex-wrap:wrap;justify-content:space-between;width:100%;max-width:400px;}
.slider-info i{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:48px;height:48px;margin-top:8px;font-size:24px;border:3px solid var(--primary);}
.slider-info p{width:calc(100% - 85px);font-family:var(--font-serif);font-style:italic;line-height:1.75;margin:0;}
.slider-explore{position:absolute;top:8px;left:50%;z-index:1;display:inline-flex;align-items:center;justify-content:center;height:53px;min-width:170px;padding:5px 15px;font-family:var(--font-accent);font-weight:700;font-size:16px;color:var(--white);text-transform:uppercase;background:rgba(0,0,0,0.38);transform:translateX(-50%);}
.slider-explore i{color:var(--primary);margin-right:10px;}
.slider-explore:hover{background:var(--black);color:var(--white);}
.slider-control{display:flex;align-items:center;align-self:flex-start;margin-top:15px;}
.slider-control p{min-width:60px;margin:0 10px;font-family:var(--font-accent);font-weight:500;text-align:center;}
.slider-control .js-current-slide{color:var(--primary);}
.slider-control button{width:90px;height:13px;overflow:hidden;text-indent:-9999px;background:transparent;transition:opacity .25s;}
.slider-control button.prev{background:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 90 13'><path d='M30 6.5H90' stroke='%23bbb' stroke-width='1'/><path d='M0 6.5l30-6v12z' fill='%23bbb'/></svg>") no-repeat center/100% 100%;}
.slider-control button.next{background:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 90 13'><path d='M0 6.5h60' stroke='%23bbb' stroke-width='1'/><path d='M90 6.5l-30-6v12z' fill='%23bbb'/></svg>") no-repeat center/100% 100%;}
.slider-control button.next:hover{filter:brightness(1.4);}
@media(max-width:1199px){.slider-heading{font-size:50px;max-width:600px;}}
@media(max-width:1023px){
  .main-slider .slide{display:flex;align-items:center;padding:160px 0 100px;}
  .main-slider article{position:static;transform:none;justify-content:flex-start;}
  .slider-heading{font-size:40px;padding:24px 0 24px 30px;}
  .slider-tools{position:relative;background:var(--black);padding:20px;}
  .slider-explore{top:-80px;}
}
@media(max-width:639px){
  .wrapper{font-size:18px;}
  .main-slider .slide{height:auto;min-height:100vh;align-items:flex-end;padding:160px 0 85px;}
  .slider-heading{padding:15px 0 10px;border-left:0;border-top:3px solid var(--primary);font-size:25px;text-align:center;line-height:1.05;}
  .slider-tools{position:absolute;bottom:0;left:0;right:0;justify-content:center;background:transparent;padding:0 0 20px;}
  .slider-explore{position:static;transform:none;}
  .slider-info,.slider-control{display:none;}
}

/* ---------- STORY ---------- */
.story{position:relative;display:flex;flex-wrap:wrap;justify-content:space-between;padding-top:200px;padding-bottom:110px;overflow:hidden;background:#fbfafa;}
.story::before{content:'';position:absolute;inset:0;background:linear-gradient(27deg,rgba(0,0,0,0.06),transparent);pointer-events:none;}
.story-left{position:relative;width:49%;padding-left:58px;z-index:3;}
.story-top{display:none;}
.story-slider{position:relative;box-shadow:30px 20px 60px rgba(0,0,0,0.3);}
.story-slider .slide{position:relative;}
.story-slider .slide img{width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;}
.story-slider .slide article{position:absolute;bottom:0;left:0;width:100%;padding:0 90px 45px;background:linear-gradient(0deg,rgba(0,0,0,0.9),rgba(0,0,0,0.1));color:var(--white);font-weight:500;font-size:14px;}
.story-slider .slide article::before{content:'';display:block;width:100%;height:5px;margin-bottom:28px;background:#737373;}
.story-slider .slide h4{font-family:var(--font-body);font-weight:700;font-size:16px;text-transform:uppercase;margin-bottom:5px;color:var(--white);}
.story-year{text-align:center;margin-top:28px;}
.story-year .year span{position:relative;display:inline-block;padding:0 30px 8px;font-family:var(--font-display);font-weight:700;font-style:italic;font-size:72px;line-height:1.2;color:var(--primary);}
.story-year .year span::before{content:'';position:absolute;top:22px;bottom:0;left:0;width:5px;background:#bfbfbf;}
.story-content{position:relative;width:44.8%;padding-left:93px;padding-right:20px;z-index:2;}
.story-content::before{content:'';position:absolute;top:5px;left:0;width:5px;height:275px;background:var(--primary);}
.story-heading{display:block;margin-bottom:112px;font-family:var(--font-body);font-weight:600;font-size:48px;letter-spacing:1.5px;line-height:1.1;text-transform:uppercase;}
.story-content h1{font-size:26px;font-weight:700;margin-bottom:36px;}
.story-content p{font-size:15px;margin-bottom:28px;}
@media(max-width:1023px){
  .story-left{width:100%;padding-left:0;padding-bottom:30px;}
  .story-content{width:100%;padding:0;margin-top:40px;}
  .story-content::before{display:none;}
  .story-heading{font-size:38px;margin-bottom:40px;}
}
@media(max-width:639px){
  .story{padding-top:60px;padding-bottom:40px;}
  .story-slider .slide article{padding:0 12px 12px;}
  .story-year .year span{font-size:50px;}
  .story-year .year span::before{top:15px;}
  .story-content h1{font-size:24px;}
}

/* ---------- ATTORNEYS ---------- */
.attorneys{display:flex;flex-wrap:wrap;justify-content:space-between;padding-top:150px;padding-bottom:138px;}
.attorneys-content{width:40%;padding-left:46px;padding-top:55px;}
.attorneys-content h2{font-family:var(--font-body);font-weight:600;font-size:48px;line-height:1;text-transform:uppercase;margin-bottom:50px;}
.attorneys-content h3{margin-bottom:35px;}
.attorneys-content p{font-size:15px;margin-bottom:30px;}
.attorneys-content .button{margin-top:20px;}
.attorneys-content article{max-height:560px;overflow-y:auto;padding-right:20px;}
.attorneys-slider{position:relative;width:49.3%;padding:22px 52px;margin-right:26px;z-index:1;}
.attorneys-slider::before,.attorneys-slider::after{content:'';position:absolute;width:190px;height:480px;background:var(--primary);z-index:-1;opacity:.08;}
.attorneys-slider::before{top:0;left:0;}
.attorneys-slider::after{bottom:0;right:0;}
.attorneys-slider .slide ul{display:flex;flex-wrap:wrap;margin:0 -35px;}
.attorneys-slider .slide li{width:50%;padding:20px 35px;}
.attorneys-block{display:block;text-align:center;background:var(--white);border-bottom:4px solid var(--primary);transition:background .25s ease-in-out;}
.attorneys-block img{width:100%;}
.attorneys-block span{position:relative;display:block;padding:8px 5px;font-weight:700;font-size:16px;line-height:1.25;letter-spacing:1.5px;color:var(--black);text-transform:uppercase;}
.attorneys-block:hover{background:var(--primary);}
.attorneys-block:hover span{color:var(--white);}
@media(max-width:1023px){
  .attorneys-content{width:100%;padding:0 0 40px;}
  .attorneys-content h2{font-size:38px;margin-bottom:20px;}
  .attorneys-slider{width:100%;margin:0;padding:22px 20px;}
  .attorneys-slider .slide li{width:50%;padding:15px 10px;}
}
@media(max-width:639px){
  .attorneys-slider .slide li{width:100%;}
  .attorneys-content h2{font-size:32px;}
}

/* ---------- APPROACH ---------- */
.approach{display:flex;flex-flow:row-reverse wrap;justify-content:space-between;padding-top:195px;padding-bottom:140px;background:#f7f7f7;}
.approach-content{width:48%;padding-left:46px;}
.approach-content h2{font-family:var(--font-body);font-weight:600;font-size:48px;line-height:1;text-transform:uppercase;margin-bottom:50px;}
.approach-content h3{line-height:1.35;margin-bottom:32px;}
.approach-content p{font-size:15px;margin-bottom:30px;}
.approach-content article{max-height:592px;overflow-y:auto;padding-right:30px;}
.approach-content .button{margin-top:10px;}
.approach-blocks{width:48.5%;padding-left:50px;position:relative;z-index:1;}
.approach-blocks ul{display:flex;flex-wrap:wrap;margin:0 -15px;}
.approach-blocks li{width:50%;padding:0 15px;margin-bottom:30px;}
.approach-block{position:relative;display:block;overflow:hidden;text-align:center;}
.approach-block img{width:100%;aspect-ratio:1/1;object-fit:cover;}
.approach-block span{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:30px 10px 10px;font-weight:700;font-size:16px;letter-spacing:1.7px;color:var(--white);text-transform:uppercase;background:rgba(0,0,0,0.4);transition:all .25s ease-in-out;}
.approach-block:hover span{color:var(--black);background:var(--primary);padding-bottom:26px;}
@media(max-width:1023px){
  .approach{padding-top:80px;padding-bottom:60px;}
  .approach-content{width:100%;padding-left:0;}
  .approach-content h2{font-size:38px;margin-bottom:24px;}
  .approach-blocks{width:100%;padding-left:0;margin-top:60px;}
}
@media(max-width:639px){
  .approach-blocks li{width:100%;}
  .approach-content h2{font-size:30px;}
}

/* ---------- HISTORY ---------- */
.history{position:relative;padding-top:128px;padding-bottom:168px;text-align:center;color:var(--white);background:#111 url("https://picsum.photos/seed/lga-history-bg/1920/1080") center/cover no-repeat;z-index:1;}
.history::after{content:'';position:absolute;inset:0;z-index:-1;background:rgba(0,0,0,0.88);}
.history-content{max-width:1010px;margin:0 auto 50px;}
.history-content h2{font-family:var(--font-body);font-weight:600;font-size:48px;line-height:1;text-transform:uppercase;margin-bottom:50px;color:var(--white);}
.history-content h3{color:var(--primary);margin-bottom:33px;}
.history-content p{font-size:15px;margin-bottom:33px;}
.history-content .button{margin-top:10px;}
.history-slider{padding:0 60px;}
.history-slider .slide{position:relative;padding:0 10px;}
.history-slider .slide h4{font-family:var(--font-body);font-weight:700;font-size:72px;color:var(--primary);margin-bottom:32px;}
.history-slider .slide span{display:block;width:100%;height:4px;background:var(--white);position:relative;}
.history-slider .slide span::after{content:'';position:absolute;top:50%;left:50%;width:22px;height:22px;background:var(--white);border:5px solid var(--black);border-radius:50%;transform:translate(-50%,-50%);}
.history-slider .slide p{margin-top:35px;font-weight:500;font-size:15px;line-height:1.4;color:#b7b7b7;}
@media(max-width:639px){
  .history{padding-top:60px;padding-bottom:60px;}
  .history-content h2{font-size:38px;margin-bottom:20px;}
  .history-slider{padding:0 30px;}
  .history-slider .slide h4{font-size:48px;}
}

/* ---------- COMMITMENT ---------- */
.commitment{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-start;padding-top:200px;padding-bottom:100px;overflow:hidden;position:relative;}
.commitment-content{position:relative;width:calc(50% - 130px);margin-left:57px;padding-left:60px;padding-right:20px;z-index:1;}
.commitment-content::before{content:'';position:absolute;top:5px;left:0;width:6px;height:275px;background:var(--primary);}
.commitment-content h2{font-family:var(--font-body);font-weight:600;font-size:48px;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:50px;}
.commitment-content h3{margin-bottom:36px;}
.commitment-content p{font-size:15px;margin-bottom:28px;}
.commitment-slider{position:relative;width:calc(50% - 75px);margin:30px 60px 70px 0;box-shadow:30px 20px 60px rgba(0,0,0,0.3);z-index:1;}
.commitment-slider iframe{display:block;width:100%;height:auto;aspect-ratio:16/9;}
.commitment-pattern{display:none;}
@media(max-width:1023px){
  .commitment{padding-top:60px;padding-bottom:60px;}
  .commitment-content{width:100%;margin:0;padding:0 0 30px;}
  .commitment-content::before{display:none;}
  .commitment-content h2{font-size:36px;margin-bottom:20px;}
  .commitment-slider{width:100%;margin:0;}
}

/* ---------- FOOTER ---------- */
.footer{position:relative;}
.footer-address{position:relative;min-height:350px;}
.footer-map{position:absolute;top:0;left:0;width:calc(50% - 145px);height:100%;background:#eaeaea;}
.footer-map img{width:100%;height:100%;object-fit:cover;}
.footer-info{display:flex;flex-wrap:wrap;justify-content:flex-end;padding-top:100px;padding-bottom:100px;color:var(--white);background:#333 url("https://picsum.photos/seed/lga-address/1920/800") center/cover no-repeat;position:relative;}
.footer-info::after{content:'';position:absolute;inset:0;background:rgba(0,0,0,0.85);}
.footer-info address{position:relative;z-index:1;width:51.7%;padding-left:70px;font-style:normal;}
.footer-info address::before{content:'';position:absolute;top:5px;left:0;width:6px;height:210px;background:var(--primary);}
.footer-info address h2{font-family:var(--font-body);font-weight:600;font-size:42px;text-transform:uppercase;margin-bottom:32px;color:var(--white);}
.footer-info address h3{margin-bottom:30px;color:var(--white);}
.footer-info address h3 a{font-weight:700;font-size:32px;color:var(--white);}
.footer-info address h3 a:hover{color:var(--primary);}
.footer-info address p{font-size:20px;line-height:1.4;margin-bottom:30px;}
.footer-info address p a{color:var(--white);}
.footer-info address p a:hover{color:var(--primary);}
.footer-partners{padding:30px 0;}
.footer-partners ul{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;margin:0 50px;}
.footer-partners li{width:25%;padding:15px;text-align:center;}
.footer-copyright{display:flex;flex-flow:row-reverse wrap;justify-content:space-between;align-items:center;padding:20px 118px;font-family:var(--font-accent);font-size:12px;background:var(--gray-light);}
.footer-copyright ul{list-style:none;margin:0;}
.footer-copyright ul li{display:inline-block;text-transform:uppercase;color:#231f20;}
.footer-copyright ul li + li::before{content:'|';margin:0 15px;opacity:.3;}
.footer-copyright ul li a{color:#231f20;}
.footer-copyright ul li a:hover{color:var(--primary);}
.footer-copyright ol{list-style:none;margin:0;}
.footer-copyright ol li{display:inline-block;padding:0 5px;}
.footer-copyright ol li a{display:flex;align-items:center;justify-content:center;width:50px;height:50px;color:var(--white);background:var(--black);font-size:20px;}
.footer-copyright ol li a:hover{background:var(--primary);color:var(--black);}
@media(max-width:1023px){
  .footer-map{position:static;width:100%;height:300px;}
  .footer-info{padding:60px 0;}
  .footer-info address{width:100%;padding-left:30px;}
  .footer-info address::before{height:160px;}
  .footer-info address h2{font-size:30px;}
  .footer-partners li{width:33.3%;}
  .footer-copyright{padding:20px;text-align:center;}
  .footer-copyright ul,.footer-copyright ol{width:100%;}
  .footer-copyright ol{margin-bottom:16px;}
}
@media(max-width:639px){
  .footer-info address{padding-left:0;text-align:center;}
