<!-- ===================== SCRIPTS ===================== -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
<script>
/* ============================================================
   LEX GLOBAL ADVOCACY — All-in-One JS
   ============================================================ */
(function($){
  'use strict';

  // Header scroll state
  var header = document.querySelector('.header');
  var onScroll = function(){
    if(!header) return;
    if(window.scrollY > 40) header.classList.add('is-fixed');
    else header.classList.remove('is-fixed');
  };
  window.addEventListener('scroll', onScroll, {passive:true});
  onScroll();

  // Mobile menu
  var nav = document.getElementById('nav');
  var toggle = document.querySelector('.header .tools .toggle');
  if(toggle && nav){
    toggle.addEventListener('click', function(e){
      e.preventDefault();
      nav.classList.toggle('is-open');
      document.body.classList.toggle('menu-open', nav.classList.contains('is-open'));
    });
  }

  // Search overlay
  var searchBar = document.querySelector('.search-bar');
  var searchOpen = document.querySelector('.header-search');
  var searchClose = document.querySelector('.search-close');
  if(searchOpen && searchBar){
    searchOpen.addEventListener('click', function(e){
      e.preventDefault();
      searchBar.classList.add('is-open');
      var input = searchBar.querySelector('input');
      if(input) input.focus();
    });
  }
  if(searchClose && searchBar){
    searchClose.addEventListener('click', function(e){
      e.preventDefault();
      searchBar.classList.remove('is-open');
    });
  }

  // Slick sliders
  if($ && $.fn && $.fn.slick){
    var $mainSlider = $('.main-slider');
    if($mainSlider.length){
      $mainSlider.on('init', function(){ revealSlides(); updateCounter(0); });
      $mainSlider.slick({
        dots:false, arrows:false, infinite:true, speed:800, fade:true,
        autoplay:true, autoplaySpeed:7000, pauseOnHover:false, pauseOnFocus:false
      });
      $mainSlider.on('afterChange', function(_e,_s,cur){ updateCounter(cur); revealSlides(); });
      document.querySelectorAll('.js-slider-left').forEach(function(b){
        b.addEventListener('click', function(){ $mainSlider.slick('slickPrev'); });
      });
      document.querySelectorAll('.js-slider-right').forEach(function(b){
        b.addEventListener('click', function(){ $mainSlider.slick('slickNext'); });
      });
    }

    var $attr = $('.attorneys-slider');
    if($attr.length){
      $attr.slick({dots:false, arrows:true, infinite:true, slidesToShow:1, slidesToScroll:1, speed:500, autoplay:true, autoplaySpeed:6000});
    }

    var $approach = $('.approach-blocks');
    if($approach.length){
      $approach.slick({dots:false, arrows:true, infinite:true, slidesToShow:1, slidesToScroll:1, speed:500, autoplay:true, autoplaySpeed:6000});
    }

    var $history = $('.history-slider');
    if($history.length){
      $history.slick({
        dots:false, arrows:true, infinite:true, slidesToShow:4, slidesToScroll:1,
        speed:500, autoplay:true, autoplaySpeed:5000,
        responsive:[
          {breakpoint:1024, settings:{slidesToShow:3}},
          {breakpoint:768,  settings:{slidesToShow:2}},
          {breakpoint:480,  settings:{slidesToShow:1}}
        ]
      });
    }

    var $story = $('.story-slider'), $year = $('.story-year');
    if($story.length && $year.length){
      $story.slick({dots:false, arrows:false, infinite:true, fade:true, speed:500, autoplay:true, autoplaySpeed:5000, asNavFor:'.story-year'});
      $year.slick({dots:false, arrows:true, infinite:true, fade:true, speed:500, slidesToShow:1, slidesToScroll:1, asNavFor:'.story-slider', autoplay:true, autoplaySpeed:5000});
    }
  }

  function updateCounter(index){
    var current = document.querySelector('.js-current-slide');
    var total = document.querySelector('.js-total-slide');
    if(current) current.textContent = String(index+1).padStart(2,'0');
    if(total){
      var count = document.querySelectorAll('.main-slider .slide').length;
      total.textContent = String(count).padStart(2,'0');
    }
  }

  function revealSlides(){
    document.querySelectorAll('.slider-heading.animate').forEach(function(el){
      el.classList.add('is-animated');
    });
  }

  // Reveal-on-scroll
  if('IntersectionObserver' in window){
    var obs = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if(entry.isIntersecting){
          entry.target.classList.add('is-animated');
          obs.unobserve(entry.target);
        }
      });
    }, {threshold:0.15});
    document.querySelectorAll('.animate').forEach(function(el){
      if(!el.closest('.slider')) obs.observe(el);
    });
  }

  // Smooth scroll
  document.querySelectorAll('a[href^="#"]').forEach(function(link){
    link.addEventListener('click', function(e){
      var href = link.getAttribute('href');
      if(!href || href === '#') return;
      var target = document.querySelector(href);
      if(!target) return;
      e.preventDefault();
      target.scrollIntoView({behavior:'smooth', block:'start'});
    });
  });

  // Cookie banner
  var cookieBanner = document.getElementById('cookie-banner');
  var COOKIE_KEY = 'lga_cookie_consent';
  if(cookieBanner){
    if(!localStorage.getItem(COOKIE_KEY)) cookieBanner.classList.add('is-visible');
    function setConsent(v){
      localStorage.setItem(COOKIE_KEY, v);
      cookieBanner.classList.remove('is-visible');
    }
    document.getElementById('cookie-accept')?.addEventListener('click', function(){ setConsent('all'); });
    document.getElementById('cookie-reject')?.addEventListener('click', function(){ setConsent('none'); });
    document.getElementById('cookie-close')?.addEventListener('click', function(){ setConsent('none'); });
  }

  // Contact form
  var contactForm = document.getElementById('contact-form');
  if(contactForm){
    contactForm.addEventListener('submit', async function(e){
      e.preventDefault();
      var payload = Object.fromEntries(new FormData(contactForm).entries());
      var btn = contactForm.querySelector('button[type="submit"]');
      var orig = btn.textContent;
      btn.textContent = 'Sending…'; btn.disabled = true;
      try{
        var res = await fetch('/api/contact', {
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body:JSON.stringify(payload)
        });
        var data = await res.json();
        if(!res.ok) throw new Error(data.error || 'Something went wrong');
        contactForm.reset();
        alert('Thank you — your message has been received.');
      }catch(err){
        alert('Sorry, something went wrong: ' + err.message);
      }finally{
        btn.textContent = orig; btn.disabled = false;
      }
    });
  }
})(window.jQuery);
</script>
</body>
</html>